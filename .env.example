# DietGate configuration (all optional; defaults are in config/*.yaml)

# Where YAML config lives (defaults to ./config)
# DIETGATE_CONFIG_DIR=./config

# SQLite database file
# DIETGATE_DB_PATH=./data/dietgate.db

# Data-plane API keys: comma-separated, overrides config/app.yaml (whose only entry is the
# local-development demo key). Use >= 16 random characters on any shared deployment.
# DIETGATE_API_KEYS=<strong-key-1>,<strong-key-2>

# Internet-facing deployment. true = refuse to start with the shipped default keys or
# keys shorter than 16 characters (DEMO_MODE=false is treated the same way).
# DIETGATE_PUBLIC=false

# Let anyone watch the dashboard (read-only, no key). Only allowed for mock-only
# instances: the app refuses to start if real providers or stored prompts are configured.
# DIETGATE_PUBLIC_DASHBOARD=false

# Admin API key for /admin/* reads (dashboard panels). Use a strong random
# value on any deployment reachable by others.
# DIETGATE_ADMIN_KEY=admin-dev-key

# Control key for POST /admin controls (simulator start/stop, policy switch,
# reset). EMPTY = controls disabled. Separate from the admin key on purpose:
# the dashboard reader key must not allow mutating a public demo.
# DIETGATE_CONTROL_KEY=

# Enable dashboard controls + built-in simulator (default true in app.yaml)
# DIETGATE_DEMO_MODE=true

# Automatically start the simulator on boot (used by docker-compose)
# DIETGATE_AUTO_START_SIM=true
# Scenario the auto-start runs (sim/scenarios.yaml): default = 2000 tasks at 25/s (~80 s),
# fast = 300 tasks. A converged learning curve needs the 2000-task run.
# DIETGATE_AUTO_SIM_SCENARIO=default

# Never forward to real providers even if keys exist (demo deployments)
# DIETGATE_DISABLE_REAL_PROVIDERS=true

# Store a truncated copy of prompts via the writer queue (default false)
# DIETGATE_STORE_PROMPTS=false

# Deterministic seed for the mock provider
# DIETGATE_SEED=42

# Real providers are optional. Without keys those models are marked unavailable.
# Model ids and prices go into config/models.yaml (see config/models.live.example.yaml).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Some newer OpenAI models want "max_completion_tokens" instead of "max_tokens":
# OPENAI_MAX_TOKENS_PARAM=max_tokens
# ANTHROPIC_API_KEY=sk-ant-...
# Any other OpenAI-compatible provider: give the model its own api_key_env/base_url in
# config/models.yaml (see the Novita example in config/models.live.example.yaml):
# NOVITA_API_KEY=...
