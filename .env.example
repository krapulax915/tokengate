# DietGate configuration (all optional; defaults are in config/*.yaml)

# Where YAML config lives (defaults to ./config)
# DIETGATE_CONFIG_DIR=./config

# SQLite database file
# DIETGATE_DB_PATH=./data/dietgate.db

# Gateway API keys come from config/app.yaml (default demo key: dg-demo-key)
# OR from this env var (comma-separated), which overrides the YAML:
# DIETGATE_API_KEYS=client-a,client-b

# PUBLIC deployment flag: when true (or when demo_mode=false), the server
# REFUSES TO START while the default credentials (admin-dev-key / dg-demo-key)
# are still configured. Local development without this flag is unaffected.
# DIETGATE_PUBLIC=true

# Admin API key for /admin/* reads (dashboard panels). Use a strong random
# value on any deployment reachable by others.
# DIETGATE_ADMIN_KEY=admin-dev-key

# Control key for POST /admin controls (simulator start/stop, policy switch,
# reset). EMPTY = controls disabled. Separate from the admin key on purpose:
# the dashboard reader key must not allow mutating a public demo.
# DIETGATE_CONTROL_KEY=

# Enable dashboard controls + built-in simulator (default true in app.yaml)
# DIETGATE_DEMO_MODE=true

# Automatically start the simulator on boot (used by docker-compose)
# DIETGATE_AUTO_START_SIM=true

# Never forward to real providers even if keys exist (demo deployments)
# DIETGATE_DISABLE_REAL_PROVIDERS=true

# Store a truncated copy of prompts via the writer queue (default false)
# DIETGATE_STORE_PROMPTS=false

# Deterministic seed for the mock provider
# DIETGATE_SEED=42

# Real providers are optional. Without keys those models are marked unavailable.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
